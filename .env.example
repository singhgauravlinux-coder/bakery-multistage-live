# Copy to .env and adjust. Everything has safe local defaults;
# CHANGE ALL SECRETS before any shared or production deployment.
POSTGRES_USER=bakery
POSTGRES_PASSWORD=bakery
POSTGRES_DB=bakery
AUTH_TOKEN_SECRET=local-dev-token-secret
LOG_LEVEL=info

# --- Session policy ---------------------------------------------------------
# The browser holds a SHORT access token and renews it silently with a
# rotating, single-use refresh token, so nothing in the UI depends on the user
# pressing reload. A session ends on whichever deadline arrives first:
#   idle     — no refresh within this window (measured from the last refresh)
#   absolute — hard ceiling counted from sign-in, activity or not
# Shorten these while testing: AUTH_SESSION_IDLE_TIMEOUT_MS=60000 makes the
# "Still there?" warning and the auto sign-out easy to observe.
AUTH_ACCESS_TOKEN_TTL_MS=900000        # 15 minutes
AUTH_REFRESH_TOKEN_TTL_MS=604800000    # 7 days
AUTH_SESSION_IDLE_TIMEOUT_MS=1800000   # 30 minutes
AUTH_SESSION_ABSOLUTE_TTL_MS=43200000  # 12 hours
# How often the verification panel re-checks status (sent to the browser).
AUTH_VERIFY_POLL_INTERVAL_MS=5000
# Public origin of the storefront — the verification email links back here as
# <APP_BASE_URL>/?verify=<token>. Must match the host people actually browse.
APP_BASE_URL=http://localhost:8080

# --- API docs ---------------------------------------------------------------
# Swagger UI is NOT served on the public /api listener. It runs on its own
# port (compose: http://localhost:3100/api/docs) so it can be published,
# firewalled or basic-auth'd by its own Ingress in Kubernetes.
DOCS_SERVER_ENABLED=true
API_DOCS_ON_GATEWAY=false              # true restores the old inline /api/docs

# Razorpay (optional locally — payment-service falls back to mock mode).
# Get keys from https://dashboard.razorpay.com -> Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMTP for notification-worker ------------------------------------------
# Unset = Mailpit (docker compose default): catches all mail locally at
# http://localhost:8025, no credentials, no sending limits. Leave it that way
# for normal development.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Crumb & Ember <no-reply@crumb-and-ember.example>
SMTP_MAX_CONNECTIONS=1

# To smoke-test against a real inbox with Gmail instead, comment the block
# above and use these. Requires 2-Step Verification on the account and an App
# Password from https://myaccount.google.com/apppasswords — your normal Gmail
# password will NOT work. Paste the 16 characters without the spaces Google
# shows. Gmail also rewrites From to the authenticated account, caps you at
# roughly 2,000 messages a day, and throttles parallel connections, so keep
# SMTP_MAX_CONNECTIONS=1 and WORKER_CONCURRENCY low. Never commit .env.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=you@gmail.com
#SMTP_PASS=abcdefghijklmnop
#SMTP_FROM=Crumb & Ember <you@gmail.com>

# Mock-provider failure rate, for exercising retries and dead-lettering.
# Ignored once SMTP_HOST is set.
NOTIFY_FAILURE_RATE=0

# --- notification-worker tuning --------------------------------------------
WORKER_CONCURRENCY=5
WORKER_BATCH_SIZE=10

